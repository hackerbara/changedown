{
  "name": "@changedown/mcp",
  "version": "0.5.0",
  "description": "MCP server for ChangeDown — durable change tracking for AI agents",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hackerbara/changedown.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "criticmarkup",
    "ai-agents",
    "change-tracking"
  ],
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./dist/index.js",
    "./internals": "./dist/internals.js",
    "./bridge/session-registry": "./dist/bridge/session-registry.js",
    "./bridge/idle-reaper": "./dist/bridge/idle-reaper.js",
    "./transport/bridge-autospawn": "./dist/transport/bridge-autospawn.js",
    "./transport/word-forwarder": "./dist/transport/word-forwarder.js",
    "./transport/fixed-port-leader": "./dist/transport/fixed-port-leader.js",
    "./transport/signals": "./dist/transport/signals.js",
    "./transport/os-shim": "./dist/transport/os-shim.js",
    "./transport/streamable-http": "./dist/transport/streamable-http.js",
    "./transport/pane-endpoint": "./dist/transport/pane-endpoint.js",
    "./lab-diagnostics": "./dist/lab-diagnostics.js",
    "./remote-backend": "./dist/remote-backend.js",
    "./pane-registration": "./dist/pane-registration.js",
    "./package.json": "./package.json",
    "./remote-worker": "./dist/remote-worker.js",
    "./launcher": {
      "types": "./src/launcher.ts",
      "default": "./dist/launcher.js"
    }
  },
  "bin": {
    "changedown-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "build:tsc": "tsc",
    "dev": "tsc --watch"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@changedown/core": "file:../core",
    "@changedown/cli": "file:../cli",
    "commander": "^13.1.0",
    "diff": "^8.0.3",
    "picomatch": "^4.0.0",
    "smol-toml": "^1.3.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/picomatch": "^3.0.0",
    "@types/ws": "^8.5.0",
    "typescript": "^5.3.0"
  }
}
