---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Mascot from '@/components/Mascot.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
---
<BaseLayout title="Not found — ChangeDown for Word">
  <Header slot="header" />
  <div class="notfound">
    <Mascot pose="idle" size={96} />
    <h1>This page isn't here.</h1>
    <p>The page you tried to reach doesn't exist on this site.</p>
    <p>Looking for the developer tools or the markdown extension? They moved to <a href="https://changedown.dev">changedown.dev</a>.</p>
    <div class="actions">
      <a href="/" class="btn-primary">Go home</a>
      <a href="/install" class="btn-ghost">Install for Word</a>
    </div>
  </div>
  <Footer slot="footer" />
</BaseLayout>
<style>
  .notfound { max-width: 540px; margin: var(--space-8) auto; text-align: center; padding: 0 var(--space-4); }
  .actions { margin-top: var(--space-5); display: flex; gap: var(--space-2); justify-content: center; }
  .btn-primary { background: var(--copper-deep); color: white; padding: 10px 18px; border-radius: 6px; text-decoration: none; font-weight: 600; transition: transform var(--transition-fast); }
  .btn-primary:hover { transform: translateY(-1px); }
  .btn-ghost { border: 1px solid var(--copper-deep); color: var(--copper-deep); padding: 9px 17px; border-radius: 6px; text-decoration: none; font-weight: 600; }
  .btn-ghost:hover { color: var(--copper-deep); border-color: var(--copper-deep); }
</style>
