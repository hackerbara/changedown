---
/**
 * Internal brand sheet — renders every design token visually so the
 * design system is reviewable at a glance.
 *
 * Removed before launch (T10.8). Until then, marked noindex.
 *
 * Visit: http://localhost:4321/dev/brand-sheet
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/Icon.astro';
import Mascot from '@/components/Mascot.astro';

const surfaceColors = [
  { name: '--cream-paper', value: '#f6f1e8', use: 'page background' },
  { name: '--cream-elev', value: '#ede4d2', use: 'cards, asides' },
  { name: '--cream-deep', value: '#e3d8be', use: 'secondary elevation' },
  { name: '--paper-white', value: '#ffffff', use: 'doc chrome inside sandbox' },
  { name: '--border-soft', value: '#d6c9a8', use: 'subtle borders' },
  { name: '--border-strong', value: '#b8a880', use: 'used sparingly' },
];
const inkColors = [
  { name: '--ink-primary', value: '#2a2823', use: 'body text' },
  { name: '--ink-secondary', value: '#5a4a30', use: 'captions, meta' },
  { name: '--ink-muted', value: '#8a7a5a', use: 'placeholders' },
];
const copperColors = [
  { name: '--copper', value: '#b67d3a', use: 'primary accent, CTAs' },
  { name: '--copper-deep', value: '#8a5a1a', use: 'hover, active' },
  { name: '--copper-light', value: '#e9d5a8', use: 'pill backgrounds' },
];
const changeColors = [
  { name: '--insert-fg', value: '#2a7a3a', use: 'insertion text' },
  { name: '--insert-underline', value: '#5dba6a', use: 'insertion underline' },
  { name: '--delete-fg', value: '#a83838', use: 'deletion text' },
  { name: '--delete-strike', value: '#c44949', use: 'deletion strike' },
  { name: '--substitute', value: '#8a5a1a', use: 'substitution' },
  { name: '--comment-fg', value: '#6b5a30', use: 'in-doc comments' },
];

const iconNames = [
  'check', 'x', 'arrow-right', 'arrow-down',
  'copy', 'shield', 'pencil', 'chevron-right', 'external-link',
];

const spacingTokens = [
  ['--space-1', '4px'], ['--space-2', '8px'], ['--space-3', '16px'],
  ['--space-4', '24px'], ['--space-5', '32px'], ['--space-6', '48px'],
  ['--space-7', '64px'], ['--space-8', '96px'],
];
---
<BaseLayout title="Brand sheet (internal)">
  <meta slot="head" name="robots" content="noindex, nofollow" />

  <article class="brand-sheet">
    <header>
      <h1>Brand sheet</h1>
      <p class="sub">Internal review surface — removed before launch (T10.8).</p>
    </header>

    <section>
      <h2>Type</h2>
      <div class="type-stack">
        <p class="t-h1">H1 display — Source Serif 4</p>
        <p class="t-h2">H2 — section heading</p>
        <p class="t-h3">H3 — subsection</p>
        <p class="t-body">
          Body — Source Sans 3. Pull up a seat. Any AI you want. Tracked changes
          in your document, the way Word has always done them.
        </p>
        <p class="t-meta">META — small caption, uppercase tracking</p>
        <p class="t-mono">code · IBM Plex Mono · const seat = 'pulled-up'</p>
      </div>
    </section>

    <section>
      <h2>Color</h2>
      <h3>Surface</h3>
      <div class="swatches">
        {surfaceColors.map((c) => (
          <div class="swatch">
            <div class="chip" style={`background:${c.value};border:1px solid #d6c9a8`}></div>
            <div class="meta"><code>{c.name}</code><br /><span>{c.value}</span><br /><em>{c.use}</em></div>
          </div>
        ))}
      </div>
      <h3>Ink</h3>
      <div class="swatches">
        {inkColors.map((c) => (
          <div class="swatch">
            <div class="chip" style={`background:${c.value}`}></div>
            <div class="meta"><code>{c.name}</code><br /><span>{c.value}</span><br /><em>{c.use}</em></div>
          </div>
        ))}
      </div>
      <h3>Copper</h3>
      <div class="swatches">
        {copperColors.map((c) => (
          <div class="swatch">
            <div class="chip" style={`background:${c.value}`}></div>
            <div class="meta"><code>{c.name}</code><br /><span>{c.value}</span><br /><em>{c.use}</em></div>
          </div>
        ))}
      </div>
      <h3>Tracked changes</h3>
      <div class="swatches">
        {changeColors.map((c) => (
          <div class="swatch">
            <div class="chip" style={`background:${c.value}`}></div>
            <div class="meta"><code>{c.name}</code><br /><span>{c.value}</span><br /><em>{c.use}</em></div>
          </div>
        ))}
      </div>
    </section>

    <section>
      <h2>Icons</h2>
      <div class="icons">
        {iconNames.map((n) => (
          <div class="icon-cell">
            <Icon name={n} size={28} ariaLabel={n} />
            <code>{n}</code>
          </div>
        ))}
      </div>
    </section>

    <section>
      <h2>Mascot (placeholder)</h2>
      <p class="sub">
        The capybara placeholders below are SVG stubs marked
        <code>data-placeholder="true"</code>. Commissioned art replaces them in T10.7.
      </p>
      <div class="mascots">
        <div class="mascot-cell"><Mascot pose="idle" size={96} /><code>idle</code></div>
        <div class="mascot-cell"><Mascot pose="working" size={96} /><code>working</code></div>
        <div class="mascot-cell"><Mascot pose="wave" size={96} /><code>wave</code></div>
      </div>
    </section>

    <section>
      <h2>Spacing scale</h2>
      <div class="spacing">
        {spacingTokens.map(([name, value]) => (
          <div class="space-row">
            <div class="space-bar" style={`width:${value}`}></div>
            <code>{name}</code><span>{value}</span>
          </div>
        ))}
      </div>
    </section>

    <section>
      <h2>Tracked-change sample</h2>
      <p class="sample-doc">
        The quarterly review surfaced three priorities for next year. Of these,
        <span class="ins">most importantly, </span>
        the migration to the new platform is the only item with hard external deadlines.
        We can defer the brand refresh
        <span class="del">if we want to</span>
        without significant downstream impact.
      </p>
    </section>
  </article>
</BaseLayout>

<style>
  .brand-sheet { max-width: 960px; margin: 0 auto; padding: var(--space-6) var(--space-5); }
  .brand-sheet header .sub { color: var(--ink-muted); }
  .brand-sheet section { margin: var(--space-7) 0; }
  .brand-sheet h2 { border-bottom: 1px solid var(--border-soft); padding-bottom: var(--space-2); margin-bottom: var(--space-4); }

  .type-stack { display: flex; flex-direction: column; gap: var(--space-3); padding: var(--space-4); background: var(--cream-elev); border-radius: 6px; }
  .t-h1 { font-family: var(--font-display); font-size: 56px; font-weight: 700; line-height: 1.1; margin: 0; }
  .t-h2 { font-family: var(--font-display); font-size: 36px; font-weight: 600; margin: 0; }
  .t-h3 { font-family: var(--font-display); font-size: 24px; font-weight: 600; margin: 0; }
  .t-body { font-family: var(--font-body); font-size: 17px; line-height: 1.6; margin: 0; }
  .t-meta { font-family: var(--font-body); font-size: 12px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-muted); margin: 0; }
  .t-mono { font-family: var(--font-mono); font-size: 13px; color: var(--ink-secondary); margin: 0; }

  .swatches { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: var(--space-3); margin-bottom: var(--space-4); }
  .swatch { background: var(--paper-white); border: 1px solid var(--border-soft); border-radius: 6px; overflow: hidden; }
  .swatch .chip { height: 56px; }
  .swatch .meta { padding: var(--space-2) var(--space-3); font-size: 12px; }
  .swatch .meta code { font-family: var(--font-mono); color: var(--ink-primary); }
  .swatch .meta span { color: var(--ink-muted); }
  .swatch .meta em { color: var(--ink-secondary); font-style: italic; }

  .icons { display: grid; grid-template-columns: repeat(auto-fill, minmax(120px, 1fr)); gap: var(--space-3); }
  .icon-cell { display: flex; flex-direction: column; align-items: center; gap: var(--space-1); padding: var(--space-3); border: 1px solid var(--border-soft); border-radius: 6px; background: var(--paper-white); color: var(--ink-primary); }
  .icon-cell code { font-size: 11px; color: var(--ink-secondary); }

  .mascots { display: flex; gap: var(--space-5); flex-wrap: wrap; }
  .mascot-cell { display: flex; flex-direction: column; align-items: center; gap: var(--space-1); }
  .mascot-cell code { font-size: 11px; color: var(--ink-secondary); }

  .spacing { display: flex; flex-direction: column; gap: var(--space-2); }
  .space-row { display: flex; align-items: center; gap: var(--space-3); }
  .space-bar { height: 16px; background: var(--copper-light); border: 1px solid var(--copper); border-radius: 2px; }
  .space-row code { min-width: 80px; font-size: 12px; }
  .space-row span { color: var(--ink-muted); font-size: 12px; }

  .sample-doc { font-size: 17px; line-height: 1.7; background: var(--paper-white); padding: var(--space-4); border: 1px solid var(--border-soft); border-radius: 6px; }
  .ins { color: var(--insert-fg); text-decoration: underline; text-decoration-color: var(--insert-underline); }
  .del { color: var(--delete-fg); text-decoration: line-through; text-decoration-color: var(--delete-strike); }
</style>
