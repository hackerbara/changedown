---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
interface Props { title: string; description: string; updatedAt?: Date; }
const { title, description, updatedAt } = Astro.props;
---
<BaseLayout title={`${title} — ChangeDown for Word`} description={description}>
  <Header slot="header" />
  <article class="editorial">
    <header>
      <h1>{title}</h1>
      <p class="subtitle">{description}</p>
    </header>
    <slot />
    {updatedAt && <footer class="updated">Updated {updatedAt.toLocaleDateString('en-US', { dateStyle: 'long' })}</footer>}
  </article>
  <Footer slot="footer" />
</BaseLayout>
<style>
  .editorial { max-width: var(--reading-width); margin: 0 auto; padding: var(--space-7) var(--space-4); }
  .subtitle { color: var(--ink-secondary); font-size: 18px; margin-top: -8px; }
  .updated { margin-top: var(--space-6); color: var(--ink-secondary); font-size: 13px; }
</style>
