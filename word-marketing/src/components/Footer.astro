---
import Icon from '@/components/Icon.astro';
import Mascot from '@/components/Mascot.astro';
---
<footer class="site-footer">
  <div class="row">
    <span class="copy">© 2026 ChangeDown</span>
    <a href="/privacy">Privacy</a>
    <a href="/terms">Terms</a>
    <a href="/security">Security</a>
    <a href="mailto:hello@changedown.com">Contact</a>
    <a href="https://changedown.dev" class="cross">
      For developers / VS Code / Markdown → changedown.dev
      <Icon name="external-link" size={14} />
    </a>
    <Mascot pose="idle" size={32} decorative />
  </div>
</footer>
<style>
  .site-footer { background: var(--cream-elev); padding: var(--space-4) var(--space-5); border-top: 1px solid var(--border-soft); }
  .row { display: flex; gap: var(--space-3); align-items: center; flex-wrap: wrap; font-size: 13px; color: var(--ink-secondary); }
  .row a { color: var(--ink-secondary); text-decoration: none; }
  .row a:hover { color: var(--ink-primary); }
  .cross { margin-left: auto; color: var(--copper-deep) !important; font-weight: 600; display: inline-flex; align-items: center; gap: 4px; }
  .cross:hover { color: var(--copper-deep) !important; }
</style>
