---
import Mascot from '@/components/Mascot.astro';
import Icon from '@/components/Icon.astro';
---
<div class="install-cta">
  <div class="mascot-col"><Mascot pose="wave" size={64} decorative /></div>
  <div class="copy-col">
    <h3>Ready to try in your own Word?</h3>
    <p>Install takes 60 seconds. Free public rooms anytime.</p>
  </div>
  <div class="cta-col">
    <a href="/install" class="primary">Install ChangeDown <Icon name="arrow-right" size={16} /></a>
    <a href="/#demo" class="ghost">Run the demo again</a>
  </div>
</div>
<style>
  .install-cta {
    background: var(--ink-primary); color: var(--cream-paper);
    padding: var(--space-5); display: flex; align-items: center;
    gap: var(--space-4); max-width: var(--wide-width); margin: 0 auto;
    border-radius: 8px; flex-wrap: wrap;
  }
  .install-cta h3 { color: var(--cream-paper); font-size: 22px; margin: 0; }
  .install-cta p { color: var(--cream-deep); font-size: 14px; margin: 4px 0 0; }
  .copy-col { flex: 1; min-width: 200px; }
  .cta-col { display: flex; gap: var(--space-2); flex-wrap: wrap; }
  .primary {
    background: var(--copper-deep); color: white;
    padding: 10px 18px; border-radius: 6px;
    text-decoration: none; font-weight: 600;
    display: inline-flex; align-items: center; gap: 6px;
    transition: transform var(--transition-fast);
  }
  .primary:hover { transform: translateY(-1px); color: white; }
  .ghost {
    color: var(--cream-paper); padding: 9px 17px;
    border-radius: 6px; text-decoration: none; font-weight: 600;
    border: 1px solid var(--ink-secondary);
  }
  .ghost:hover { border-color: var(--cream-deep); color: var(--cream-paper); }
</style>
